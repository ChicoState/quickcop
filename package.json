{
  "name": "quickcop-infrastructure",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.cjs --passWithNoTests",
    "coverage": "jest --coverage --passWithNoTests",
    "test:smoke": "bash scripts/smoke-postgres.sh",
    "mutation": "stryker run",
    "audit": "npm audit --omit=dev --audit-level=high",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/jest-runner": "^8.6.0",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.11.10",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
